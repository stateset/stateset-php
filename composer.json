{
    "name": "stateset/php-client",
    "description": "Official StateSet PHP SDK - A modern, comprehensive PHP client for the StateSet API with support for returns, warranties, work orders, and more",
    "type": "library",
    "keywords": [
        "stateset",
        "api",
        "sdk",
        "php",
        "client",
        "returns",
        "warranties",
        "work-orders",
        "inventory",
        "openapi",
        "rest"
    ],
    "homepage": "https://stateset.com",
    "license": "MIT",
    "authors": [
        {
            "name": "StateSet Team",
            "email": "developers@stateset.com",
            "homepage": "https://stateset.com"
        }
    ],
    "support": {
        "issues": "https://github.com/stateset/stateset-php/issues",
        "docs": "https://docs.stateset.com",
        "email": "support@stateset.com"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^1.12",
        "mockery/mockery": "^1.6",
        "symfony/var-dumper": "^7.0",
        "roave/security-advisories": "dev-master"
    },
    "autoload": {
        "psr-4": { 
            "StateSet\\Client\\": "lib/" 
        }
    },
    "autoload-dev": {
        "psr-4": { 
            "StateSet\\Client\\Test\\": "test/" 
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "quality": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
